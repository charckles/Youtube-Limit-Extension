{
  "manifest_version": 3,
  "name": "StudyGate",
  "version": "0.1.0",
  "description": "A hard block on every YouTube video, except playlists you whitelist for courses and studying.",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "src/background/worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["src/lib/policy.js", "src/lib/storage.js", "src/content/guard.js"],
      "css": ["src/content/guard.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "StudyGate settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
